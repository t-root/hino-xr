# Copied by the Python process.
# Model files are fetched into assistant/weights/ (gitignored) on the first run. Merged LoRA = a new GGUF.

# VR_MODEL_PATH=assistant/weights/qwen2.5-3b-instruct-q4_k_m.gguf
# VR_WHISPER_PATH=assistant/weights/ggml-large-v3-q5_0.bin
# VR_WHISPER_WAKE_PATH=assistant/weights/ggml-small.bin
# VR_VOICE_VI_PATH=assistant/weights/vits-piper-vi_VN-vais1000-medium
# VR_N_THREADS=8
# VR_N_GPU_LAYERS=0
# VR_N_CTX=4096
# VR_CHAT_FORMAT=qwen

# Who thinks for the assistant: local (default, offline, keyword commands only) or api (needs a key).
# With api, a model also hears requests the keywords miss ("noi cham lai chut") and works the menu through tool calls.
# Say "dung API de viet plugin" / "dung local" to switch while running.
# VR_CODE_SOURCE=local
# VR_ANTHROPIC_KEY=
# VR_CODE_MODEL=claude-sonnet-5-5   (writes plugins)
# VR_AGENT_MODEL=claude-haiku-5-5   (works the menu by tool calls)
