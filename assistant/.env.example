# Copied by the Python process.
# Every setting is commented out: the defaults run everything on this machine, offline.
#
# Each STAGE has one switch, VR_<STAGE>_SOURCE = local | api, and the same two things to choose either way:
#
#   stage     switch            local (a file on disk)                      api = SiliconFlow (a model name)
#   --------  ----------------  ------------------------------------------  ----------------------------------
#   LLM       VR_LLM_SOURCE     VR_MODEL_PATH       qwen2.5-3b (GGUF)       VR_LLM_MODEL
#   CODE      VR_CODE_SOURCE    the same Qwen, a 2nd session (see below)    VR_CODE_MODEL  (default: VR_LLM_MODEL)
#   AGENT     VR_CODE_SOURCE    -- (keyword commands; api only)             VR_AGENT_MODEL (default: VR_LLM_MODEL)
#   STT       VR_STT_SOURCE     VR_WHISPER_PATH, VR_WHISPER_WAKE_PATH       VR_STT_MODEL
#   TTS       VR_TTS_SOURCE     VR_VOICE_VI_PATH (VieNeu); SAPI for en      VR_TTS_MODEL, VR_TTS_VOICE
#
# CODE = writing and changing plugins; AGENT = working the menu by tool calls (hears requests the keywords miss).
# Say "dung API" / "dung local" to switch VR_CODE_SOURCE while running.
# A failed cloud call falls back to the local model; the stage is not tried again for a minute.

# --- on this machine ---------------------------------------------------------------
# Model files are fetched into assistant/weights/ (gitignored) on the first run. Merged LoRA = a new GGUF.
# VR_MODEL_PATH=assistant/weights/qwen2.5-3b-instruct-q4_k_m.gguf
# VR_WHISPER_PATH=assistant/weights/ggml-large-v3-q5_0.bin
# VR_WHISPER_WAKE_PATH=assistant/weights/ggml-small.bin
# VR_VOICE_VI_PATH=assistant/weights/vieneu   (turbo/ and codec/ inside)
# VR_N_THREADS=8                 CPU threads for answering and for Whisper: set it to the number of PHYSICAL cores
#                                 (the default counts hyper-threads, which makes llama.cpp slower, not faster)
# VR_WHISPER_BEAM=5              candidate sentences Whisper weighs for a question: 5 is most accurate, 1 to 2 is much faster
# VR_N_GPU_LAYERS=0              0 = CPU, -1 = every layer on the GPU
# VR_N_CTX=4096
# VR_CHAT_FORMAT=qwen
# Writing a plugin runs as a second session of the same model, so a question is answered meanwhile (both slow down
# a little while sharing the CPU). The weights are shared on disk; only the working memory is added.
# VR_N_THREADS_CODE=             default: a third of VR_N_THREADS
# VR_N_CTX_CODE=                 default: the larger of 8192 and VR_N_CTX

# --- in the cloud: SiliconFlow (https://docs.siliconflow.com) ----------------------
# VR_SILICONFLOW_KEY=
# VR_LLM_SOURCE=local
# VR_CODE_SOURCE=local
# VR_STT_SOURCE=local
# VR_TTS_SOURCE=local
# VR_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct   one model for answering, writing plugins and the menu
# VR_CODE_MODEL=                           only to use a different one for plugins
# VR_AGENT_MODEL=                          only to use a different one for the menu
# VR_STT_MODEL=FunAudioLLM/SenseVoiceSmall
# VR_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
# VR_TTS_VOICE=alex
# SiliconFlow's speech models do not list Vietnamese, so listening and speaking go to the cloud only for these
# languages; the rest stay on this machine. Add vi to try it.
# VR_CLOUD_VOICE_LANGS=en
# Listening and speaking can use another provider that does hear and speak Vietnamese, each on its own:
# VR_STT_URL=https://api.groq.com/openai/v1   any OpenAI-style /audio/transcriptions
# VR_STT_KEY=
# VR_STT_MODEL=whisper-large-v3-turbo
# VR_TTS_URL=                                 any OpenAI-style /audio/speech (then VR_TTS_KEY, VR_TTS_MODEL, VR_TTS_VOICE)
# VR_TTS_PROVIDER=azure                       or Azure Speech:
# VR_AZURE_KEY=
# VR_AZURE_REGION=southeastasia
# VR_AZURE_VOICE_VI=vi-VN-HoaiMyNeural
# VR_AZURE_VOICE_EN=en-US-JennyNeural
# VR_STT_LANGS=                               default vi,en for a stage with its own provider
# VR_TTS_LANGS=
# VR_SILICONFLOW_URL=https://api.siliconflow.com/v1

# --- looking at pictures: "what is this", "read this", "translate this" ---------------
# local = Qwen2.5-VL 3B on this computer (about 3 GB, fetched by run.py only when this is set, and slow on a CPU);
# api = a SiliconFlow model that reads pictures, and the picture goes there. Say "dung API de nhin hinh" to switch.
# VR_VISION_SOURCE=local
# VR_VISION_MODEL=Qwen/Qwen2.5-VL-32B-Instruct
# VR_VISION_MODEL_PATH=assistant/weights/Qwen2.5-VL-3B-Instruct-Q4_K_M.gguf
# VR_VISION_MMPROJ_PATH=assistant/weights/mmproj-Qwen2.5-VL-3B-Instruct-Q8_0.gguf
# VR_VISION_HANDLER=qwen25vl     qwen25vl | gemma4 | moondream | llava15 | minicpmv26
# VR_VISION_N_CTX=4096

# --- tools: the weather and look-ups go to Open-Meteo and Wikipedia when asked for ----
# VR_TOOLS=on                    off = answer that they are unavailable, send nothing
# VR_HOME_CITY=                  the city for "thời tiết" when none is said

# --- who may use the server --------------------------------------------------------
# The computer's own browser needs no key. Any other device (the phone) sends the access key; the address printed at
# start-up carries it as ?key=. Without VR_ACCESS_TOKEN a random key is made once and kept in assistant/data/access.key.
# VR_ACCESS_TOKEN=
# VR_ACCESS=on                   off = no key needed on a network you trust (requests from other websites are still refused)
